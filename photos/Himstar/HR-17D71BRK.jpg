4282003718,"additiveBackground":734638661,"textPrimary":4294768606,"textSecondary":4293647773,"invertedBackground":4293120381,"overlayBackground":3426365702},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"2022"},"label":{"simpleText":"अगस्ट 4"},"accessibilityText":"2022 अगस्ट 4","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294966512,"raisedBackground":4294966512,"additiveBackground":566866501,"textPrimary":4282003718,"textSecondary":4287067425,"invertedBackground":4286738199,"overlayBackground":3426365702},"darkThemeColorPalette":{"baseBackground":4280096769,"raisedBackground":4282003718,"additiveBackground":734638661,"textPrimary":4294768606,"textSecondary":4293647773,"invertedBackground":4293120381,"overlayBackground":3426365702},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBQQ040EGAYiEwiMwp61gKSWAxWRRp0JHWVkFufKAQQkJZPc","commandMetadata":{"webCommandMetadata":{"url":"/@HimElectronicsNepal","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UC4U3G-Sn3ldoYPkcP4Dx2jg","canonicalBaseUrl":"/@HimElectronicsNepal"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/N2eKkFGSJoxkCavwJkIqgXPDlRE0IrgyYrPh7S-8mSDesMF9awjrA6UCA4IZreXk3osLSUm1ng=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"थप देखाउनुहोस्"}},"simpleText":"...थप"},"showLessText":{"simpleText":"थोरै देखाउनुहोस्"},"attributedDescriptionBodyText":{"content":"Himstar Refrigerators are the go-to refrigerators in Nepal.\nWith digital inverter technology and a 5-star rating Himstar refrigerators are cost-effective and energy-efficient.\nThough spacious it occupies little of your kitchen space.\nWe have two widely used variants, one being the single-door refrigerator and the next being the double-door refrigerator. These refrigerators come in different volumes ranging from 190 liters to 253 liters.\n\nConnect with us through:\nWebsite URL: https://himstar.himelectronics.com/\nFacebook Page:   / himelectronics  \nInstagram Page:   / himstarnepal  \n\nHimstar Products are available in EMI (Easy Monthly Installment).\nTo Apply for EMI: https://himelectronics.com/EMI\n\nHimstar products are available in exchange through Arkostore.\nTo exchange visit: https://www.arkostore.com/\n\nFor any queries, contact us @:\nToll-Free No.: 1660-01-88088\nPhone no: 01-5970705\nEmail: info.him@golchhagroup.com.np\n\nHave you had a great experience with Himstar Products? Let us know in the comments below!\n\nAbout Us:\nHim Electronics Pvt. Ltd. is an Electronics \u0026 Electricals company dedicated to delivering quality products in the Nepali market. Learn more about Him Electronics at https://www.himelectronics.com/\n\n#himstar #refrigerator #stylish #spacious #summertime #fridge","commandRuns":[{"startIndex":480,"length":35,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwiMwp61gKSWAxWRRp0JHWVkFudIqer71dzjsLAKygEEJCWT3A==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUTJwMDl3a3F2a1RNbXpKb2JMOWVIUnxBR3JiS2FtT3NvdEgzZGx6ZkFuS29aZVhYbC1KVWFFdUhnRi0xcU50bEZCQnNBYUotbXpyVTl0dmM0b2hoOVRsVW5rdEhjWWYtaXU3YURfOWt1UlZ5dzJiRl9PWlBvb2o1LUho\u0026q=https%3A%2F%2Fhimstar.himelectronics.com%2F\u0026v=CmDDHcq-9Sk","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUTJwMDl3a3F2a1RNbXpKb2JMOWVIUnxBR3JiS2FtT3NvdEgzZGx6ZkFuS29aZVhYbC1KVWFFdUhnRi0xcU50bEZCQnNBYUotbXpyVTl0dmM0b2hoOVRsVW5rdEhjWWYtaXU3YURfOWt1UlZ5dzJiRl9PWlBvb2o1LUho\u0026q=https%3A%2F%2Fhimstar.himelectronics.com%2F\u0026v=CmDDHcq-9Sk","target":"TARGET_NEW_WINDOW"