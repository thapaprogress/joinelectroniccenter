{"startIndex":1230,"length":8,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1238,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1239,"length":13,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1252,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1253,"length":8,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1261,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1262,"length":9,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1271,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1272,"length":11,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1283,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1284,"length":7,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294966512,"raisedBackground":4294966512,"additiveBackground":566866501,"textPrimary":4282003718,"textSecondary":4287067425,"invertedBackground":4286738199,"overlayBackground":3426365702},"darkThemeColorPalette":{"baseBackground":4280096769,"raisedBackground":4282003718,"additiveBackground":734638661,"textPrimary":4294768606,"textSecondary":4293647773,"invertedBackground":4293120381,"overlayBackground":3426365702},"colorSampledDescriptionBodyText":{"content":"Himstar Refrigerators are the go-to refrigerators in Nepal.\nWith digital inverter technology and a 5-star rating Himstar refrigerators are cost-effective and energy-efficient.\nThough spacious it occupies little of your kitchen space.\nWe have two widely used variants, one being the single-door refrigerator and the next being the double-door refrigerator. These refrigerators come in different volumes ranging from 190 liters to 253 liters.\n\nConnect with us through:\nWebsite URL: https://himstar.himelectronics.com/\nFacebook Page:   / himelectronics  \nInstagram Page:   / himstarnepal  \n\nHimstar Products are available in EMI (Easy Monthly Installment).\nTo Apply for EMI: https://himelectronics.com/EMI\n\nHimstar products are available in exchange through Arkostore.\nTo exchange visit: https://www.arkostore.com/\n\nFor any queries, contact us @:\nToll-Free No.: 1660-01-88088\nPhone no: 01-5970705\nEmail: info.him@golchhagroup.com.np\n\nHave you had a great experience with Himstar Products? Let us know in the comments below!\n\nAbout Us:\nHim Electronics Pvt. Ltd. is an Electronics \u0026 Electricals company dedicated to delivering quality products in the Nepali market. Learn more about Him Electronics at https://www.himelectronics.com/\n\n#himstar #refrigerator #stylish #spacious #summertime #fridge","commandRuns":[{"startIndex":480,"length":35,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwiMwp61gKSWAxWRRp0JHWVkFudIqer71dzjsLAKygEEJCWT3A==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUmRFWHQtSWdYU0VTWUZ0R2RJbWtSeHxBR3JiS2FrTDVjdVNmWC0tTHZYVzYyMnYyc21DOHZFVXhMdFRRWXRxTWI3UEcwelFVMlNPaksybktuLVJzb2JhY2lqcDlVMXRjX1MyaGx5OUQxRXBKcDlJNlRYTnFsUlp5bEUt\u0026q=https%3A%2F%2Fhimstar.himelectronics.com%2F\u0026v=CmDDHcq-9Sk","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUmRFWHQtSWdYU0VTWUZ0R2RJbWtSeHxBR3JiS2FrTDVjdVNmWC0tTHZYVzYyMnYyc21DOHZFVXhMdFRRWXRxTWI3UEcwelFVMlNPaksybktuLVJzb2JhY2lqcDlVMXRjX1MyaGx5OUQxRXBKcDlJNlRYTnFsUlp5bEUt\u0026q=https%3A%2F%2Fhimstar.himelectronics.com%2F\u0026v=CmDDHcq-9Sk","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":531,"length":20,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwi